# Evoker iOS: build products and per-user Xcode / SwiftPM state (the repository root .gitignore has the same
# patterns; keep the two in sync).
.build/
DerivedData/
xcuserdata/
*.xcuserstate
.swiftpm/xcode/
*.xcscmblueprint

# SwiftPM on Windows / Linux writes the test resource bundle's Info.plist into the package root
EvokerCore/Info.plist

# written by `xcodegen generate` (project.yml `info.path`); the hand-written project generates its plist itself
Support/Info.plist

.DS_Store
Thumbs.db
